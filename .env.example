# Скопировать в .env и заполнить (на сервере .env НЕ коммитится).

# Публичный адрес проекта.
PUBLIC_ORIGIN=https://pixelforge.tirskix.space
# Встроенный редактор GDevelop (переиспользуем уже развёрнутый инстанс).
GDEVELOP_ORIGIN=https://gdevelop.tirskix.space

# PostgreSQL.
POSTGRES_PASSWORD=change-me

# MinIO / S3.
S3_ACCESS_KEY=pixelforge
S3_SECRET_KEY=change-me
S3_BUCKET=pixelforge-submissions

# LMS SSO — временные заглушки, подключим позже реальные значения от LMS.
LMS_WEBHOOK_SECRET=placeholder-change-later
LMS_JWT_SECRET=placeholder-change-later-min-32-bytes-long-xxxxx
